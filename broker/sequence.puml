@startuml
title Broker Sequence Diagram

actor User

box "Slurm side" #8e9dce
participant "Slurm" as Slurm
participant "Prolog\nqdmi-broker-prolog" as Prolog
participant "SPANK\niqm-spank-plugin" as SPANK
participant "Epilog\nqdmi-broker-epilog" as Epilog
participant "qdmi-brokerctl" as BrokerCtl
end box

participant "User Job\nIQMBackend" as Job

box "Service node"  #7fcac9
participant "qdmi-brokerd" as Daemon
database "Allocation Store" as Store
participant "Configured QDMI Device\n(e.g. IQM)" as QDMI
end box


== Daemon start ==

Daemon -> Daemon: load broker.toml\n(socket_path, device_library, symbol_prefix, device_token, target_map)

Daemon -> Daemon: load device_library and resolve symbol_prefix + QDMI symbols

Daemon -> QDMI: QDMI_device_initialize()


== Submit Slurm job ==

User -> Slurm: sbatch --qpu=qpuA,qpuB --licenses=qpuA:1,qpuB:1 job.sh

note left of Slurm
job.sh contains user code, e.g.

from iqm.qdmi.qiskit import IQMBackend

backend_A = IQMBackend(qc_alias="qpuA")
backend_B = IQMBackend(qc_alias="qpuB")

sampler_A = backend_A.sampler()
sampler_B = backend_B.sampler()

job_A = sampler_A.run([(qc_A,)], shots=1000)
job_B = sampler_B.run([(qc_B,)], shots=1000)

status_A = job_A.status()
result_A = job_A.result()
result_B = job_B.result()
end note


== Allocate sessions ==

Slurm -> Prolog: Prolog=/usr/libexec/qdmi-broker/qdmi-broker-prolog

Prolog -> BrokerCtl: create-allocations(job_id, uid, resources=[qpuA, qpuB])

BrokerCtl -> Daemon: create_allocations(job_id, uid, resources)

Daemon -> Daemon: create job socket_path

loop for resource in [qpuA, qpuB]
Daemon -> Daemon: generate allocation_id

Daemon -> Daemon: map resource to base_url

Daemon -> QDMI: QDMI_device_session_alloc(&session)

Daemon -> QDMI: QDMI_device_session_set_parameter(session,\nQDMI_DEVICE_SESSION_PARAMETER_TOKEN, device_token_size, device_token)

Daemon -> QDMI: QDMI_device_session_set_parameter(session,\nQDMI_DEVICE_SESSION_PARAMETER_BASEURL, base_url_size, base_url)

Daemon -> QDMI: QDMI_device_session_init(session)

Daemon -> Store: save(allocation_id, job_id, uid, resource, socket_path, session, status=active)

Store --> Daemon: ok
end

Daemon --> BrokerCtl: socket_path, resource map

BrokerCtl --> Prolog: ok


== Inject broker env ==

Slurm -> SPANK: slurm_spank_task_init(sp, ac, argv)

SPANK -> BrokerCtl: get-allocations(job_id, uid)

BrokerCtl -> Daemon: get_allocations(job_id, uid)

Daemon -> Store: get_allocations(job_id, uid)

Store --> Daemon: socket_path, resource map

Daemon --> BrokerCtl: socket_path, resource map

BrokerCtl --> SPANK: socket_path, resource map

SPANK -> SPANK: spank_setenv(sp, "BROKER_SOCKET", socket_path, 1)

SPANK -> SPANK: spank_setenv(sp, "ALLOCATIONS", "qpuA=allocation_id_A;qpuB=allocation_id_B", 1)

note right of SPANK
Broker injects broker-only job env.
Vendor auth stays inside qdmi-brokerd.
end note

Slurm -> Job: execve(path, argv, envp)


== Submit QDMI jobs ==

Job -> Job: IQMBackend reads BROKER_SOCKET and ALLOCATIONS

loop for each logical QPU job
Job -> Daemon: submit_job(allocation_id, program, shots)

Daemon -> Store: lookup(allocation_id)

Store --> Daemon: allocation + session

Daemon -> Store: authorize(SO_PEERCRED(fd), allocation_id)

Daemon -> QDMI: QDMI_device_session_create_device_job(session, &device_job)

Daemon -> QDMI: QDMI_device_job_set_parameter(device_job,\nQDMI_DEVICE_JOB_PARAMETER_PROGRAMFORMAT, sizeof(format), &format)

Daemon -> QDMI: QDMI_device_job_set_parameter(device_job,\nQDMI_DEVICE_JOB_PARAMETER_PROGRAM, program_size, program)

Daemon -> QDMI: QDMI_device_job_set_parameter(device_job,\nQDMI_DEVICE_JOB_PARAMETER_SHOTSNUM, sizeof(size_t), &shots)

Daemon -> QDMI: QDMI_device_job_submit(device_job)

Daemon -> Daemon: generate task_id

Daemon -> Store: save_task(allocation_id, task_id, device_job)

Store --> Daemon: ok

Daemon --> Job: task_id
end


== Check status and get result ==

Job -> Daemon: status(allocation_id, task_id)

Daemon -> Store: lookup_task(allocation_id, task_id)

Store --> Daemon: allocation + device_job

Daemon -> Store: authorize(SO_PEERCRED(fd), allocation_id)

Daemon -> QDMI: QDMI_device_job_check(device_job, &status)

Daemon --> Job: status

Job -> Daemon: result(allocation_id, task_id)

Daemon -> Store: lookup_task(allocation_id, task_id)

Store --> Daemon: allocation + device_job

Daemon -> Store: authorize(SO_PEERCRED(fd), allocation_id)

Daemon -> QDMI: QDMI_device_job_get_results(device_job,\nQDMI_JOB_RESULT_SHOTS, result_size, result, nullptr)

QDMI --> Daemon: result

Daemon --> Job: result


== Cleanup ==

Slurm -> Epilog: Epilog=/usr/libexec/qdmi-broker/qdmi-broker-epilog

Epilog -> BrokerCtl: revoke-allocations(job_id)

BrokerCtl -> Daemon: revoke_allocations(job_id)

Daemon -> Store: lookup_active_allocations(job_id)

Store --> Daemon: tracked device_jobs, sessions, allocation_ids

loop for each tracked device_job
Daemon -> QDMI: QDMI_device_job_free(device_job)

QDMI --> Daemon: void
end

loop for each session
Daemon -> QDMI: QDMI_device_session_free(session)

QDMI --> Daemon: void
end

loop for each allocation_id
Daemon -> Store: revoke(allocation_id)

Store --> Daemon: ok
end

Daemon --> BrokerCtl: ok

BrokerCtl --> Epilog: ok


== Daemon stop ==

Daemon -> QDMI: QDMI_device_finalize()
@enduml
